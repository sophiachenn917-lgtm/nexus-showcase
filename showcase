// ----------------------------------------------------------------------
// 组件：上传/管理弹窗 (支持本地文件选择转换为 Base64 及网络 URL)
// ----------------------------------------------------------------------
function UploadModal({ onClose, onAdd }) {
  const [formData, setFormData] = useState({
    name: '',
    tagline: '',
    category: 'Visual',
    badge: '新品上市',
    heroImage: '',
    description: '',
    features: [
      { title: '', description: '', image: '' }
    ],
    specs: [
      { label: '', value: '' }
    ]
  });

  // 读取本地图片文件转为 Base64 格式
  const handleFileUpload = (e, callback) => {
    const file = e.target.files[0];
    if (file) {
      const reader = new FileReader();
      reader.onloadend = () => {
        callback(reader.result);
      };
      reader.readAsDataURL(file);
    }
  };

  const handleSubmit = (e) => {
    e.preventDefault();
    if (!formData.name || !formData.heroImage) return;

    const newProduct = {
      ...formData,
      id: Date.now().toString(),
      gallery: [formData.heroImage]
    };

    onAdd(newProduct);
    onClose();
  };

  const updateFeature = (index, field, val) => {
    const updated = [...formData.features];
    updated[index][field] = val;
    setFormData({ ...formData, features: updated });
  };

  const addFeatureRow = () => {
    setFormData({
      ...formData,
      features: [...formData.features, { title: '', description: '', image: '' }]
    });
  };

  const updateSpec = (index, field, val) => {
    const updated = [...formData.specs];
    updated[index][field] = val;
    setFormData({ ...formData, specs: updated });
  };

  const addSpecRow = () => {
    setFormData({
      ...formData,
      specs: [...formData.specs, { label: '', value: '' }]
    });
  };

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-xl overflow-y-auto">
      <div className="relative w-full max-w-2xl bg-slate-900 border border-slate-800 rounded-3xl shadow-2xl p-6 sm:p-8 my-8">
        <button
          onClick={onClose}
          className="absolute top-4 right-4 p-2 text-slate-400 hover:text-white rounded-full"
        >
          <X className="w-5 h-5" />
        </button>

        <h2 className="text-2xl font-bold text-white mb-6 flex items-center gap-2">
          <Plus className="w-6 h-6 text-indigo-400" /> 发布新产品
        </h2>

        <form onSubmit={handleSubmit} className="space-y-6">
          <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label className="block text-xs font-medium text-slate-400 mb-1">产品名称 *</label>
              <input
                type="text"
                required
                value={formData.name}
                onChange={(e) => setFormData({ ...formData, name: e.target.value })}
                placeholder="例: Pro Wireless Earbuds"
                className="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-xl text-slate-200 text-sm focus:outline-none focus:border-indigo-500"
              />
            </div>
            <div>
              <label className="block text-xs font-medium text-slate-400 mb-1">分类</label>
              <select
                value={formData.category}
                onChange={(e) => setFormData({ ...formData, category: e.target.value })}
                className="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-xl text-slate-200 text-sm focus:outline-none focus:border-indigo-500"
              >
                <option value="Visual">Visual</option>
                <option value="Audio">Audio</option>
                <option value="Smart Home">Smart Home</option>
                <option value="Mobile">Mobile</option>
              </select>
            </div>
          </div>

          <div>
            <label className="block text-xs font-medium text-slate-400 mb-1">一句话短标 (Tagline)</label>
            <input
              type="text"
              value={formData.tagline}
              onChange={(e) => setFormData({ ...formData, tagline: e.target.value })}
              placeholder="例: 静无止境，音真意切"
              className="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-xl text-slate-200 text-sm focus:outline-none focus:border-indigo-500"
            />
          </div>

          {/* 封面图片上传/输入 */}
          <div>
            <label className="block text-xs font-medium text-slate-400 mb-1">封面高清图 *</label>
            <div className="flex gap-2 items-center">
              <input
                type="text"
                required
                value={formData.heroImage}
                onChange={(e) => setFormData({ ...formData, heroImage: e.target.value })}
                placeholder="输入网络图片 URL 或选择本地文件"
                className="flex-1 px-3 py-2 bg-slate-950 border border-slate-800 rounded-xl text-slate-200 text-sm focus:outline-none focus:border-indigo-500"
              />
              <label className="px-3 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-xl text-xs font-medium cursor-pointer flex items-center gap-1.5 transition">
                <Upload className="w-3.5 h-3.5" /> 上传
                <input
