                  onChange={(e) => handleFileUpload(e, (res) => setFormData({ ...formData, heroImage: res }))}
                />
              </label>
            </div>
          </div>

          <div>
            <label className="block text-xs font-medium text-slate-400 mb-1">完整介绍文案</label>
            <textarea
              rows="3"
              value={formData.description}
              onChange={(e) => setFormData({ ...formData, description: e.target.value })}
              placeholder="请输入产品背景与整体描述..."
              className="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-xl text-slate-200 text-sm focus:outline-none focus:border-indigo-500"
            ></textarea>
          </div>

          {/* 卖点设置 */}
          <div className="space-y-3">
            <label className="block text-xs font-medium text-slate-400">核心卖点图文</label>
            {formData.features.map((feat, idx) => (
              <div key={idx} className="p-3 bg-slate-950 border border-slate-800 rounded-xl space-y-2">
                <input
                  type="text"
                  placeholder="卖点标题 (如: 40dB 深度主动降噪)"
                  value={feat.title}
                  onChange={(e) => updateFeature(idx, 'title', e.target.value)}
                  className="w-full px-3 py-1.5 bg-slate-900 border border-slate-800 rounded-lg text-slate-200 text-xs"
                />
                <input
                  type="text"
                  placeholder="卖点描述"
                  value={feat.description}
                  onChange={(e) => updateFeature(idx, 'description', e.target.value)}
                  className="w-full px-3 py-1.5 bg-slate-900 border border-slate-800 rounded-lg text-slate-200 text-xs"
                />
                <div className="flex gap-2">
                  <input
                    type="text"
                    placeholder="卖点图片 URL 或上传本地图片"
                    value={feat.image}
                    onChange={(e) => updateFeature(idx, 'image', e.target.value)}
                    className="flex-1 px-3 py-1.5 bg-slate-900 border border-slate-800 rounded-lg text-slate-200 text-xs"
                  />
                  <label className="px-2 py-1 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-lg text-xs font-medium cursor-pointer flex items-center gap-1 transition">
                    <Upload className="w-3 h-3" />
                    <input
                      type="file"
                      accept="image/*"
                      className="hidden"
                      onChange={(e) => handleFileUpload(e, (res) => updateFeature(idx, 'image', res))}
                    />
                  </label>
                </div>
              </div>
            ))}
            <button
              type="button"
              onClick={addFeatureRow}
              className="text-xs text-indigo-400 hover:text-indigo-300 font-medium"
            >
              + 添加卖点
            </button>
          </div>

          {/* 参数设置 */}
          <div className="space-y-3">
            <label className="block text-xs font-medium text-slate-400">规格参数</label>
            {formData.specs.map((spec, idx) => (
              <div key={idx} className="flex gap-2">
                <input
                  type="text"
                  placeholder="参数名 (如: 电池容量)"
                  value={spec.label}
                  onChange={(e) => updateSpec(idx, 'label', e.target.value)}
                  className="w-1/3 px-3 py-1.5 bg-slate-950 border border-slate-800 rounded-lg text-slate-200 text-xs"
                />
                <input
                  type="text"
                  placeholder="参数值 (如: 500mAh)"
                  value={spec.value}
                  onChange={(e) => updateSpec(idx, 'value', e.target.value)}
                  className="w-2/3 px-3 py-1.5 bg-slate-950 border border-slate-800 rounded-lg text-slate-200 text-xs"
                />
              </div>
            ))}
            <button
              type="button"
              onClick={addSpecRow}
              className="text-xs text-indigo-400 hover:text-indigo-300 font-medium"
            >
              + 添加参数
            </button>
          </div>

          <button
            type="submit"
            className="w-full py-3 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold rounded-xl transition shadow-lg shadow-indigo-600/30"
          >
            保存并实时渲染
          </button>
        </form>
      </div>
    </div>
  );
}
